<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Every C# block on the documentation site is a region of a file in this project, pulled in
        by DocFX's code-include syntax. The site cannot show a sample this project does not
        compile, and `dotnet run` re-checks each sample's output against expected/*.txt, which is
        what the site prints as the result, so a sample and its output cannot drift apart without
        the check failing.

        See docfx/docs/contributing-to-the-docs.md for the two commands that run and re-record it.
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>12</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <RootNamespace>CSharpAuthor.Docs.Samples</RootNamespace>
        <IsPackable>false</IsPackable>
        <!-- The samples are prose. A sample that only warns still has to compile, and warnings
             here would otherwise be lost in the library's own build output. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <!--
            A ProjectReference, not the source-include path, deliberately: this project stands in
            for a consumer that references CSharpAuthor as an ordinary library. The source-include
            path that a real generator uses is exercised separately, by
            docfx/samples/CSharpAuthor.Docs.Samples.Generator.
        -->
        <ProjectReference Include="../../../CSharpAuthor/CSharpAuthor.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Recorded output, not code. -->
        <None Include="expected/*.txt" />
    </ItemGroup>

</Project>
