<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Runs CSharpAuthor.Docs.Samples.Generator over a small compilation and checks what it
        produced against the recordings in ../CSharpAuthor.Docs.Samples.Generator/expected/, which
        is what docfx/docs/source-generators.md prints as the generator's output.

        It deliberately does not reference CSharpAuthor: the generator has the library compiled
        into it, so referencing both would put two copies of every public CSharpAuthor type in
        scope here. That is the source-inclusion model showing through, and it is worth seeing.
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>12</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <RootNamespace>CSharpAuthor.Docs.Samples.GeneratorRunner</RootNamespace>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
        <ProjectReference Include="../CSharpAuthor.Docs.Samples.Generator/CSharpAuthor.Docs.Samples.Generator.csproj" />
    </ItemGroup>

</Project>
