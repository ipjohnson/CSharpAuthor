<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
	  <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Adversary suite only. The adversary's assertion is "the emitted string compiles", which needs
      a compiler. This is the TEST project; CSharpAuthor.csproj takes no new dependency (handoff §3).
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="SimpleFixture.NSubstitute" Version="4.0.0-RC190" />
    <PackageReference Include="SimpleFixture.xUnit" Version="4.0.0-RC190" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSharpAuthor\CSharpAuthor.csproj" />
  </ItemGroup>

  <!--
    Roslyn is a test-time reference only. The shipped library still targets netstandard2.0 with no
    Roslyn dependency; this is here so the emitter's output can be handed to a real compiler
    instead of compared against a string somebody typed, and so the Roslyn-gated source folder is
    actually compiled by something.

    EmitProfileRoslynExtensions.cs is linked rather than referenced because it is excluded from the
    library assembly by design. Its sibling EmitProfile.Roslyn.cs is deliberately NOT linked: it is
    a partial of a type that already exists in the referenced assembly, so it only compiles in the
    source-include configuration it ships for.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <Compile Include="..\CSharpAuthor\Roslyn\EmitProfileRoslynExtensions.cs" Link="Roslyn\EmitProfileRoslynExtensions.cs" />
  </ItemGroup>

</Project>
