<Project>
  <!--
    Source inclusion. The consumer compiles CSharpAuthor's own .cs files into its assembly,
    which is why a source generator can use this library without a dependency it would then
    have to ship.

    The grammar nodes under src/CSharpAuthor/Syntax stay out of the consumer's public API
    on their own: they carry `#if CSHARPAUTHOR_PUBLIC_SYNTAX / public / #endif`, and only
    CSharpAuthor.csproj defines that symbol. Compiled here without it, they take C#'s
    default accessibility for a top-level type, which is internal. Nothing needs to be set
    below, and nothing may unset it - defining CSHARPAUTHOR_PUBLIC_SYNTAX in a consumer
    would put roughly 250 node types into that consumer's public API surface.

    The Compile glob is recursive, so CSharpAuthor/Syntax/*.cs is picked up with no change
    here at all.
  -->
    Opting into the Roslyn bridge implies opting into the source, because the bridge is written
    against the type model and the package is normally referenced with IncludeAssets="build" - which
    brings no assembly with it. Setting PackageCSharpAuthorIncludeSource to false explicitly still
    wins, for a consumer referencing the library as an assembly.
  -->
  <PropertyGroup Condition="'$(PackageCSharpAuthorIncludeRoslyn)' == 'true' and '$(PackageCSharpAuthorIncludeSource)' == ''">
    <PackageCSharpAuthorIncludeSource>true</PackageCSharpAuthorIncludeSource>
  </PropertyGroup>

  <ItemGroup Condition="'$(PackageCSharpAuthorIncludeSource)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)../src/**/*.cs" Visible="false"/>
  </ItemGroup>

  <!--
    The Roslyn bridge: EmitProfile.FromEditorConfig(AnalyzerConfigOptions) and the language
    version detection. It extends EmitProfile as a partial, so it needs the core compiled in
    beside it - hence both properties. A generator project already references Roslyn, so this
    adds no package to anything.
  -->
  <ItemGroup Condition="'$(PackageCSharpAuthorIncludeSource)' == 'true' AND '$(PackageCSharpAuthorIncludeRoslyn)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)../srcRoslyn/**/*.cs" Visible="false"/>
  </ItemGroup>
</Project>
